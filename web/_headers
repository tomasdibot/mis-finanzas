# Cloudflare static assets: the app shell, manifest and icons must always be re-checked, so a new logo or version shows up
# right away on phones instead of an old cached copy.
/manifest.webmanifest
  Content-Type: application/manifest+json
  Cache-Control: no-cache
/sw.js
  Cache-Control: no-cache
/icons/*
  Cache-Control: no-cache
/apple-touch-icon.png
  Cache-Control: no-cache
/favicon.ico
  Cache-Control: no-cache
